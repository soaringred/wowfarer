---
/** The Wowfarer mark: a waypoint arrow, lit side left, shadowed side right. Inline so it's crisp and themeable. */
interface Props { size?: number; class?: string }
const { size = 28, class: cls } = Astro.props;
---
<svg class={cls} width={size} height={size} viewBox="0 0 32 32" aria-hidden="true" focusable="false">
  <polygon points="16,2 4,29 16,23" fill="var(--logo-light, #EDF0F5)" />
  <polygon points="16,2 28,29 16,23" fill="var(--logo-dark, #C8902E)" />
  <line x1="16" y1="2" x2="16" y2="23" stroke="var(--bg, #0B0D12)" stroke-width="1.25" stroke-linecap="round" />
</svg>
